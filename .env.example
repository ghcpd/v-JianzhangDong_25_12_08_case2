# Environment configuration for secure Flask application
# Copy this file to .env and fill in actual values (do not commit .env to version control)

# Flask Configuration
FLASK_ENV=production
FLASK_DEBUG=False
FLASK_APP=inputs.py

# Security Secrets (load from secure vault in production)
PAYMENT_TOKEN=your_payment_token_here
MAIL_SERVER_KEY=your_mail_server_key_here
INTERNAL_AUTH_KEY=your_internal_auth_key_here

# Database
DB_FILE=appdata.db

# Logging
LOG_LEVEL=INFO
